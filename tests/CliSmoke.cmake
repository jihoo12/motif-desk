if(NOT DEFINED CLI OR NOT DEFINED FIXTURE OR NOT DEFINED OUTDIR)
    message(FATAL_ERROR "CLI, FIXTURE, and OUTDIR are required")
endif()
file(MAKE_DIRECTORY "${OUTDIR}")
set(wav "${OUTDIR}/solo.wav")
set(mid "${OUTDIR}/melody.mid")
set(comp "${OUTDIR}/ab.wav")
set(b "${OUTDIR}/changed.motif")
file(REMOVE "${wav}" "${mid}" "${comp}" "${b}")
file(READ "${FIXTURE}" original)
string(REPLACE "\"pitch\": 62, \"beat\": 4," "\"pitch\": 65, \"beat\": 4," revised "${original}")
if(original STREQUAL revised)
    message(FATAL_ERROR "Comparable fixture did not change")
endif()
file(WRITE "${b}" "${revised}")
execute_process(COMMAND "${CLI}" render "${FIXTURE}" "${wav}" --bars 2:2 COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CLI}" export-midi "${FIXTURE}" "${mid}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CLI}" compare "${FIXTURE}" "${b}" "${comp}" --bars 2:2 COMMAND_ERROR_IS_FATAL ANY)
file(READ "${wav}" riff LIMIT 4)
file(READ "${mid}" mthd LIMIT 4)
file(SIZE "${wav}" wavSize)
file(SIZE "${comp}" compSize)
if(NOT riff STREQUAL "RIFF" OR NOT mthd STREQUAL "MThd" OR wavSize LESS 576000 OR compSize LESS 1324800)
    message(FATAL_ERROR "Unexpected WAV/MIDI outputs")
endif()
execute_process(COMMAND "${CLI}" render "${FIXTURE}" "${wav}" RESULT_VARIABLE overwrite OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND "${CLI}" render "${FIXTURE}" "${OUTDIR}/bad-bars.wav" --bars 3:1 RESULT_VARIABLE invalid OUTPUT_QUIET ERROR_QUIET)
if(overwrite STREQUAL "0" OR NOT invalid STREQUAL "2" OR EXISTS "${OUTDIR}/bad-bars.wav")
    message(FATAL_ERROR "Invalid command or overwrite was accepted")
endif()
